# Copy to .env and fill in. Never commit .env (C6.1).
# This project can also read its .env from another folder:
# set the PARAKH_ENV_FILE environment variable to that file's full path.
APP_ENV=dev
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5

# Langfuse tracing (C4.1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Production secrets come from AWS (C6.4); only the region is needed locally
AWS_REGION=ap-south-1

# Project-specific
CAS_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_DB_PASSWORD=
